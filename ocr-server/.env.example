# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# Required. The extension must send this as "Authorization: Bearer <key>".
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRANSLATOR_API_KEY=replace-with-a-long-random-app-key

# TAMUS AI chat endpoint. The server always uses protected.gemini-2.5-flash-lite.
TAMUS_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai
TAMUS_AI_CHAT_API_KEY=replace-with-your-tamu-ai-key

# Optional tuning
# RATE_LIMIT_PER_MIN=30
# RATE_LIMIT_PER_DAY=1500
# UPSTREAM_CONCURRENCY=4
# UPSTREAM_TIMEOUT_MS=45000
# TRUST_PROXY=1   # set when behind a reverse proxy (Render sets this automatically)
